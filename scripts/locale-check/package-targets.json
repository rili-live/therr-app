{
  "$schema": "./schema.json",
  "description": "Declarative list of locale directories to validate for key-parity across locales. Each entry names a logical package and points at a directory whose children are locale folders (e.g. en-us/, es/, fr-ca/) each containing a dictionary.json. The baseLocale is the source of truth; every other locale in 'expectedLocales' must have exactly the same deep key set. Locales present on disk but not listed in 'expectedLocales' are ignored. If a package intentionally ships only a subset of locales today (e.g. the dashboard is en-us only), list only that one locale; the parity check becomes a no-op and the script remains green. Each target also names a 'srcDir'; phase 2 scans it for translate() calls and fails when a referenced key has no string value in the base dictionary (the translator echoes the raw key path to the user on a miss). Pre-existing misses are listed in referenced-keys-baseline.json, which is a one-way ratchet — see that file.",
  "targets": [
    {
      "name": "therr-client-web",
      "srcDir": "therr-client-web/src",
      "baseDir": "therr-client-web/src/locales",
      "baseLocale": "en-us",
      "expectedLocales": [
        "en-us",
        "es",
        "fr-ca"
      ]
    },
    {
      "name": "therr-client-web-dashboard",
      "srcDir": "therr-client-web-dashboard/src",
      "baseDir": "therr-client-web-dashboard/src/locales",
      "baseLocale": "en-us",
