<?xml version="1.0" encoding="utf-8"?>
<!--
  Friends with Habits streak widget: the daily streak count over the chameleon. Drawn by
  widget/HabitsStreakWidgetProvider.kt from the same snapshot as the leaderboard widget. Only
  RemoteViews-safe views: FrameLayout, LinearLayout, ImageView, TextView.

  The art fills the card (centerCrop) and is clipped to its rounded corners by clipToOutline,
  which launchers honor from Android 12; older ones draw it square-cornered. The art has sky
  above and beside the chameleon so the crop keeps its face from a tall 2x3 to a wide 3x2.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/habits_streak_widget_background"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/habits_streak_widget_art" />

    <!-- The root carries the spoken description ("75 day streak"), set by the provider, so
         TalkBack reads the card once rather than the flame, the digits and the label apart. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp">

        <!-- Hidden in the empty state, so the initial layout is the label alone. -->
        <LinearLayout
            android:id="@+id/widget_streak_count_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/habits_streak_widget_flame" />

            <TextView
                android:id="@+id/widget_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="@color/habits_streak_widget_text_shadow"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="@color/habits_widget_text"
                android:textSize="34sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_streak_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:shadowColor="@color/habits_streak_widget_text_shadow"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/habits_widget_empty"
            android:textColor="@color/habits_streak_widget_label"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
