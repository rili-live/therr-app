<?xml version="1.0" encoding="utf-8"?>
<!--
  Friends with Habits home-screen widget. Drawn by widget/HabitsWidgetProvider.kt from the
  snapshot the app publishes (main/utilities/habitsWidget.ts). Only RemoteViews-safe views:
  LinearLayout, FrameLayout, TextView, ProgressBar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/habits_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/habits_widget_empty"
        android:textColor="@color/habits_widget_text"
        android:textSize="14sp" />

    <!-- Hidden until a snapshot exists, so the initial layout is the empty state. -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header: Friends / Everyone toggle + reset countdown -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Which board the rows and rank show. Each half is its own tap target; the
                 provider fills the selected one. -->
            <LinearLayout
                android:id="@+id/widget_scope_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/habits_widget_chip_track"
                android:orientation="horizontal"
                android:padding="1dp">

                <TextView
                    android:id="@+id/widget_scope_friends"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/habits_widget_text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_scope_global"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/habits_widget_text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Board name, only for a snapshot written before the toggle existed. -->
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/habits_widget_text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Takes the slack, so a narrow widget ellipsizes the countdown rather than
                 clipping the toggle or the refresh label. -->
            <TextView
                android:id="@+id/widget_reset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/habits_widget_text_muted"
                android:textSize="11sp" />

            <!-- Freshness: "↻ 5m ago", or "Refreshing…" while a background refresh runs.
                 Tapping it asks for a refresh. Padded rather than margined so the tap target
                 is wider than the text. -->
            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="2dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/habits_widget_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Your standing: rank, XP, daily streak -->
        <LinearLayout
            android:id="@+id/widget_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/habits_widget_accent"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_rank_context"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/habits_widget_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/habits_widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:textColor="@color/habits_widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_new_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/habits_widget_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Today's check-ins -->
        <LinearLayout
            android:id="@+id/widget_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_today_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/habits_widget_text_muted"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/widget_today_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:progressBackgroundTint="@color/habits_widget_track"
                android:progressTint="@color/habits_widget_accent" />

            <TextView
                android:id="@+id/widget_today_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/habits_widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:background="@color/habits_widget_track" />

        <!-- Top of the board; rows are added by the provider (widget_habits_row / _invite) -->
        <LinearLayout
            android:id="@+id/widget_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
