<!-- values-es / values-fr-rCA carry only the home-screen widget strings; everything else
     deliberately falls back to these. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="app_name">Friends with Habits</string>
    <string name="filter_view_https_therr">Friends with Habits App Link</string>
    <string name="appCenterCrashes_whenToSendCrashes" moduleConfig="true" translatable="false">DO_NOT_ASK_JAVASCRIPT</string>
    <string name="appCenterAnalytics_whenToEnableAnalytics" moduleConfig="true" translatable="false">ALWAYS_SEND</string>
    <string name="default_notification_channel_id">reminders</string>
    <string name="shortcut_create_moment_short">Moment</string>
    <string name="shortcut_create_moment_long">Create a Moment</string>
    <string name="shortcut_create_thought_short">Thought</string>
    <string name="shortcut_create_thought_long">Create a Thought</string>
    <!-- Home-screen widget. The widget's live labels come from the JS dictionaries (they
         follow the in-app locale); these are the ones shown before the app has written one. -->
    <string name="habits_widget_label">Habits leaderboard</string>
    <string name="habits_widget_description">Your weekly rank, streak and today\'s check-ins</string>
    <string name="habits_widget_empty">Open Friends with Habits to see your progress</string>
    <string name="habits_widget_loading">Loading your progress…</string>
    <string name="habits_widget_refreshing">Refreshing…</string>
    <string name="habits_widget_refresh_hint">Tap to refresh</string>
    <!-- Streak widget (layout/widget_habits_streak.xml). Like the leaderboard widget's, its live
         label comes from the JS snapshot; these cover the picker and a snapshot that predates
         the streak block. -->
    <string name="habits_streak_widget_label">Habits streak</string>
    <string name="habits_streak_widget_description">Your daily streak, at a glance</string>
    <string name="habits_streak_widget_start">Check in today to start your streak</string>
    <plurals name="habits_streak_widget_days">
        <item quantity="one">day streak</item>
        <item quantity="other">day streak</item>
    </plurals>
    <string name="habits_streak_widget_preview_count" translatable="false">12</string>
    <string name="habits_streak_widget_preview_label">day streak</string>
</resources>
