# TherrMobile's package-lock.json is generated with --legacy-peer-deps (see the root
# CLAUDE.md). Without it, npm auto-installs *required* peer dependencies that this bare
# React Native app does not actually use -- most notably `expo-build-properties` (a
# non-optional peer of @logrocket/react-native), which drags in the entire Expo SDK
# (`expo`, `@expo/cli`, ~200 packages), plus `typescript` via @typescript-eslint/*.
#
# EAS Build runs a bare `npm ci` with no flags, so the flag has to live here rather than
# in a command line: `npm ci` then re-resolves those peers, finds they are absent from the
# lock file, and fails the "Install dependencies" phase with
#   `npm ci` can only install packages when your package.json and package-lock.json ... are in sync
#   Missing: expo-build-properties@<v> from lock file
#
# This file is scoped to TherrMobile only. The monorepo root and the Docker builds must
# NOT use legacy peer resolution.
legacy-peer-deps=true
