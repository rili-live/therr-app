{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-briefing.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.memsearch\" && \"$CLAUDE_PROJECT_DIR/scripts/memsearch-index.sh\" >> \"$CLAUDE_PROJECT_DIR/.memsearch/index.log\" 2>&1 || true",
            "async": true,
            "statusMessage": "Refreshing memory index..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/transcript-capture.js\""
          }
        ]
      }
    ]
  }
}
