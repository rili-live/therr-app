<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="canonical" href="{{canonicalUrl}}">
    <meta name="description" content="{{description}}">
    <meta name="author" content="Therr Inc.">
    <!-- Invite URLs are personal and token-bearing — never index them. -->
    <meta name="robots" content="noindex">
    <meta property="og:site_name" content="Friends with Habits">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{description}}">
    {{#if hasAvatar}}<meta property="og:image" content="{{avatarUri}}">{{/if}}
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{title}}">
    <meta name="twitter:description" content="{{description}}">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;800&display=swap">
    <link rel="icon" type="image/x-icon" href="/assets/images/favicon-habits.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-habits-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-habits-16x16.png">
    <style>
        :root {
            --habits-navy: #102a43;
            --habits-coral: #ff6b35;
            --habits-coral-dark: #e0521e;
            --habits-cream: #fff8f3;
            --habits-text: #243b53;
            --habits-text-muted: #627d98;
            --habits-border: #d9e2ec;
        }
        *, *::before, *::after { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            font-family: 'Lexend', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            font-size: 16px;
            line-height: 1.6;
            color: var(--habits-text);
            background: var(--habits-cream);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        a { color: var(--habits-coral-dark); text-decoration: none; }
        a:hover { text-decoration: underline; }
        .container { max-width: 720px; margin: 0 auto; padding: 0 1.5rem; }
        header.site-header {
            padding: 1.25rem 0;
            border-bottom: 1px solid var(--habits-border);
            background: #fff;
        }
        header.site-header .container {
            display: flex;
            align-items: center;
            gap: 0.625rem;
        }
        header.site-header .brand-mark {
            width: 2rem;
            height: 2rem;
            display: block;
        }
        header.site-header .brand {
            font-weight: 800;
            font-size: 1.125rem;
            color: var(--habits-navy);
            letter-spacing: -0.01em;
        }
        .invite {
            padding: 3rem 0 2.5rem;
            text-align: center;
        }
        .invite .avatar {
            display: block;
            width: 112px;
            height: 112px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto 1.25rem;
            background: var(--habits-border);
            border: 4px solid #fff;
            box-shadow: 0 4px 16px rgba(16, 42, 67, 0.08);
        }
        .invite .avatar-placeholder {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 112px;
            height: 112px;
            border-radius: 50%;
            background: var(--habits-coral);
            color: #fff;
            font-weight: 800;
            font-size: 2.5rem;
            margin: 0 auto 1.25rem;
            border: 4px solid #fff;
            box-shadow: 0 4px 16px rgba(16, 42, 67, 0.08);
        }
        .invite h1 {
            font-size: 1.875rem;
            font-weight: 800;
            line-height: 1.2;
            color: var(--habits-navy);
            margin: 0 0 0.75rem;
            letter-spacing: -0.02em;
            word-break: break-word;
        }
        .invite .lede {
            color: var(--habits-text-muted);
            font-size: 1.125rem;
            margin: 0 auto 2rem;
            max-width: 480px;
        }
        .cta {
            display: inline-block;
            padding: 0.9375rem 2.25rem;
            background: var(--habits-coral);
            color: #fff;
            font-weight: 600;
            font-size: 1.0625rem;
            border-radius: 999px;
            transition: background 0.15s ease, transform 0.15s ease;
        }
        .cta:hover {
            background: var(--habits-coral-dark);
            text-decoration: none;
            transform: translateY(-1px);
        }
        .cta-note {
            margin: 1rem auto 0;
            font-size: 0.875rem;
            color: var(--habits-text-muted);
            max-width: 420px;
        }
        .invite-code {
            display: inline-block;
            margin-top: 1.5rem;
            padding: 0.625rem 1rem;
            background: #fff;
            border: 1px solid var(--habits-border);
            border-radius: 0.5rem;
            font-size: 0.875rem;
            color: var(--habits-text-muted);
            word-break: break-all;
        }
        .invite-code strong {
            color: var(--habits-navy);
            font-weight: 600;
        }
        section.steps {
            padding: 2.5rem 0 3rem;
            border-top: 1px solid var(--habits-border);
        }
        section.steps h2 {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--habits-navy);
            margin: 0 0 1.5rem;
            text-align: center;
        }
        .step-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            gap: 1.25rem;
        }
        .step-list li {
            display: flex;
            gap: 0.875rem;
            align-items: flex-start;
        }
        .step-num {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--habits-navy);
            color: #fff;
            font-size: 0.875rem;
            font-weight: 700;
        }
        .step-list p { margin: 0; color: var(--habits-text-muted); }
        footer.site-footer {
            padding: 2rem 0 3rem;
            border-top: 1px solid var(--habits-border);
            background: #fff;
            text-align: center;
            color: var(--habits-text-muted);
            font-size: 0.875rem;
        }
        footer.site-footer .footer-links {
            margin-bottom: 0.75rem;
        }
        footer.site-footer .footer-links a {
            margin: 0 0.5rem;
            color: var(--habits-text-muted);
        }
        footer.site-footer .footer-family {
            margin-top: 0.5rem;
        }
        @media (min-width: 640px) {
            .invite { padding: 4rem 0 3rem; }
            .invite h1 { font-size: 2.25rem; }
            .step-list { grid-template-columns: repeat(3, 1fr); }
        }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="container">
            <img class="brand-mark" src="/assets/images/habits-logo.svg" width="32" height="32" alt="" aria-hidden="true">
            <a class="brand" href="/" style="color: var(--habits-navy);">Friends with Habits</a>
        </div>
    </header>

    <main>
        <section class="invite">
            <div class="container">
                {{#if hasAvatar}}
                    <img class="avatar" src="{{avatarUri}}" alt="{{inviterName}}">
                {{else}}
                    {{#if firstInitial}}
                        <span class="avatar-placeholder" aria-hidden="true">{{firstInitial}}</span>
                    {{/if}}
                {{/if}}
                <h1>{{heading}}</h1>
                <p class="lede">{{body}}</p>
                <!--
                    Friends with Habits applicationId — NOT app.therrmobile. Sending an
                    invitee to the Therr listing installs an app that cannot accept the
                    invite or claim the pact. Hardcoded rather than interpolated because
                    Handlebars escapes '=' in an attribute to &#x3D;.
                -->
                <a class="cta" href="https://play.google.com/store/apps/details?id=com.therr.habits" rel="noopener">Get Friends with Habits</a>
                <div class="cta-note">{{ctaNote}}</div>
                {{#if inviteCodeLabel}}
                    <div class="invite-code"><strong>{{inviteCodeLabel}}:</strong> {{inviteCode}}</div>
                {{/if}}
            </div>
        </section>

        <section class="steps">
            <div class="container">
                <h2>How it works</h2>
                <ol class="step-list">
                    <li>
                        <span class="step-num">1</span>
                        <p>Install the app and create your account.</p>
                    </li>
                    <li>
                        <span class="step-num">2</span>
                        <p>Pick a daily habit and pact up with the friend who invited you.</p>
                    </li>
                    <li>
                        <span class="step-num">3</span>
                        <p>Check in every day and keep each other on streak.</p>
                    </li>
                </ol>
            </div>
        </section>
    </main>

    {{> habitsFooter}}
</body>
</html>
