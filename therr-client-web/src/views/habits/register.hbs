<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="canonical" href="{{canonicalUrl}}">
    <meta name="description" content="{{description}}">
    <meta name="robots" content="noindex">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;800&display=swap">
    <link rel="icon" type="image/x-icon" href="/assets/images/favicon-habits.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-habits-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-habits-16x16.png">
    <style>
        :root {
            --habits-navy: #102a43;
            --habits-coral: #ff6b35;
            --habits-coral-dark: #e0521e;
            --habits-cream: #fff8f3;
            --habits-text: #243b53;
            --habits-text-muted: #627d98;
            --habits-border: #d9e2ec;
            --habits-error: #c53030;
        }
        *, *::before, *::after { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            font-family: 'Lexend', -apple-system, BlinkMacSystemFont, sans-serif;
            font-size: 16px;
            line-height: 1.6;
            color: var(--habits-text);
            background: var(--habits-cream);
            min-height: 100vh;
        }
        a { color: var(--habits-coral-dark); }
        header.site-header {
            padding: 1.25rem 0;
            border-bottom: 1px solid var(--habits-border);
            background: #fff;
        }
        .container {
            max-width: 480px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }
        header.site-header .container {
            display: flex;
            align-items: center;
            gap: 0.625rem;
        }
        header.site-header .brand-mark {
            width: 2rem;
            height: 2rem;
            display: block;
        }
        header.site-header .brand {
            font-weight: 800;
            font-size: 1.125rem;
            color: var(--habits-navy);
            letter-spacing: -0.01em;
        }
        main.wrap {
            padding: 3.5rem 0 3rem;
        }
        h1 {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--habits-navy);
            margin: 0 0 0.5rem;
            letter-spacing: -0.02em;
            text-align: center;
        }
        p.lede {
            color: var(--habits-text-muted);
            margin: 0 0 1.75rem;
            text-align: center;
        }
        form.signup-form {
            background: #fff;
            border: 1px solid var(--habits-border);
            border-radius: 0.75rem;
            padding: 1.5rem;
            box-shadow: 0 1px 2px rgba(16, 42, 67, 0.04);
        }
        label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            margin: 0 0 0.375rem;
            color: var(--habits-navy);
        }
        input[type="email"], input[type="password"] {
            width: 100%;
            padding: 0.75rem 0.875rem;
            border: 1px solid var(--habits-border);
            border-radius: 0.5rem;
            font-size: 1rem;
            font-family: inherit;
            margin-bottom: 1rem;
            background: #fff;
        }
        input[type="email"]:focus, input[type="password"]:focus {
            outline: 2px solid var(--habits-coral);
            outline-offset: 1px;
        }
        .cta {
            display: inline-block;
            width: 100%;
            padding: 0.875rem 1.75rem;
            background: var(--habits-coral);
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
            border-radius: 999px;
            border: 0;
            cursor: pointer;
            transition: background 0.15s ease;
            text-decoration: none;
            text-align: center;
        }
        .cta:hover { background: var(--habits-coral-dark); }
        .cta:disabled { background: var(--habits-text-muted); cursor: not-allowed; }
        .alert {
            padding: 0.75rem 0.875rem;
            border-radius: 0.5rem;
            margin: 0 0 1rem;
            font-size: 0.9375rem;
            border: 1px solid;
        }
        .alert--error { background: #fff5f5; color: var(--habits-error); border-color: #fed7d7; }
        .alert--success { background: #f0fff4; color: #2f855a; border-color: #c6f6d5; }
        .helper {
            text-align: center;
            margin-top: 1rem;
            font-size: 0.875rem;
            color: var(--habits-text-muted);
        }
        footer.site-footer {
            padding: 2rem 0 3rem;
            border-top: 1px solid var(--habits-border);
            background: #fff;
            text-align: center;
            color: var(--habits-text-muted);
            font-size: 0.875rem;
        }
        footer.site-footer .footer-links {
            margin-bottom: 0.75rem;
        }
        footer.site-footer .footer-links a {
            margin: 0 0.5rem;
            color: var(--habits-text-muted);
        }
        footer.site-footer .footer-family {
            margin-top: 0.5rem;
        }
        input[type="date"], input[type="text"] {
            width: 100%;
            padding: 0.75rem 0.875rem;
            border: 1px solid var(--habits-border);
            border-radius: 0.5rem;
            font-size: 1rem;
            font-family: inherit;
            margin-bottom: 1rem;
            background: #fff;
        }
        input[type="date"]:focus, input[type="text"]:focus {
            outline: 2px solid var(--habits-coral);
            outline-offset: 1px;
        }
        .checkline {
            display: flex;
            align-items: flex-start;
            gap: 0.625rem;
            margin: 0 0 1rem;
            font-size: 0.9375rem;
        }
        .checkline input { margin-top: 0.3rem; flex: 0 0 auto; }
        .checkline label { font-weight: 400; margin: 0; color: var(--habits-text); }
        .field-hint {
            font-size: 0.8125rem;
            color: var(--habits-text-muted);
            margin: -0.625rem 0 1rem;
        }
        /* Honeypot. Off-screen rather than display:none - a bot that renders
           CSS skips hidden fields, and one that does not sees a normal input. */
        .hp-field {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
        }
        [hidden] { display: none !important; }
    </style>
    {{> habitsAnalytics}}
</head>
<body>
    <header class="site-header">
        <div class="container">
            <img class="brand-mark" src="/assets/images/habits-logo.svg" width="32" height="32" alt="" aria-hidden="true">
            <span class="brand">Friends with Habits</span>
        </div>
    </header>

    <main class="wrap">
        <div class="container">
            <h1>Create your account</h1>
            <p class="lede">Free for five habits. Set it up here, then pact up with a friend in the app.</p>

            <div class="alert alert--success" id="signup-done" hidden>
                Account created. Check your email to verify it, then open the Friends with Habits app and sign in.
                <div style="margin-top:0.875rem">
                    <a class="cta" id="store-cta-done" href="https://play.google.com/store/apps/details?id=com.therr.habits" rel="noopener">Get it on Google Play</a>
                </div>
            </div>

            <form class="signup-form" id="signup-form" novalidate>
                <div class="alert alert--error" id="signup-error" hidden></div>

                <label for="email">Email</label>
                <input id="email" type="email" name="email" autocomplete="email" required>

                <label for="password">Password</label>
                <input id="password" type="password" name="password" autocomplete="new-password" required>
                <p class="field-hint">At least 8 characters.</p>

                <label for="repeat_password">Repeat password</label>
                <input id="repeat_password" type="password" name="repeatPassword" autocomplete="new-password" required>

                <label for="birthdate">Date of birth</label>
                <input id="birthdate" type="date" name="settingsBirthdate" autocomplete="bday" required>
                <p class="field-hint">Friends with Habits is not for under-13s, so we have to ask.</p>

                {{!
                    Honeypot. The server rejects any registration carrying a
                    non-empty `website` (handlers/users.ts -> createUser), so the
                    name must stay exactly that. Labelled and tab-indexed out so
                    a screen reader does not read it to a real person.
                }}
                <div class="hp-field" aria-hidden="true">
                    <label for="sweety_pie">Leave this field empty</label>
                    <input id="sweety_pie" type="text" name="website" tabindex="-1" autocomplete="off">
                </div>

                <div class="checkline">
                    <input id="agree" type="checkbox" required>
                    <label for="agree">
                        I agree to the <a href="/terms-of-service">Terms of Service</a>
                        and <a href="/privacy-policy">Privacy Policy</a>.
                    </label>
                </div>

                <div class="checkline">
                    <input id="marketing" type="checkbox" checked>
                    <label for="marketing">Email me habit tips and product updates.</label>
                </div>

                <button class="cta" type="submit" id="signup-submit">Create account</button>

                <div class="helper">
                    Already have an account? <a href="/login">Sign in</a>.
                </div>
            </form>
        </div>
    </main>

    {{> habitsFooter}}

    <script>
        (function () {
            var API_BASE = {{{apiBaseJson}}};
            var STORE_URL = 'https://play.google.com/store/apps/details?id=com.therr.habits';
            var form = document.getElementById('signup-form');
            var emailInput = document.getElementById('email');
            var passwordInput = document.getElementById('password');
            var repeatInput = document.getElementById('repeat_password');
            var birthdateInput = document.getElementById('birthdate');
            var honeypotInput = document.getElementById('sweety_pie');
            var agreeInput = document.getElementById('agree');
            var marketingInput = document.getElementById('marketing');
            var submitBtn = document.getElementById('signup-submit');
            var errorBox = document.getElementById('signup-error');
            var doneBox = document.getElementById('signup-done');

            var qs = new URLSearchParams(window.location.search);
            var prefillEmail = qs.get('email');
            if (prefillEmail) { emailInput.value = prefillEmail; }
            emailInput.focus();

            function showError(msg) {
                errorBox.textContent = msg;
                errorBox.hidden = false;
            }

            function clearError() {
                errorBox.hidden = true;
                errorBox.textContent = '';
            }

            function track(name, params) {
                // gtag is defined by habitsAnalytics, but only actually sends
                // when a measurement id is configured. Guard anyway: analytics
                // must never be what breaks a registration.
                try {
                    if (typeof window.gtag === 'function') { window.gtag('event', name, params || {}); }
                } catch (e) { /* no-op */ }
            }

            // Written on first landing by the habitsAttribution partial, in the
            // shape main."userAcquisition" expects. Advisory: the server
            // sanitizes it and drops it silently if malformed, so a bad read
            // must cost telemetry and never the signup.
            function storedAttribution() {
                try {
                    var raw = window.sessionStorage.getItem('therrUserAcquisition');
                    return raw ? JSON.parse(raw) : undefined;
                } catch (e) {
                    return undefined;
                }
            }

            // Mirrors isValidSignupAge in the React client. The server enforces
            // its own rule; this is only to fail fast with a useful message.
            function isOldEnough(value) {
                var dob = new Date(value);
                if (isNaN(dob.getTime())) { return false; }
                var cutoff = new Date();
                cutoff.setFullYear(cutoff.getFullYear() - 13);
                return dob <= cutoff;
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                clearError();

                var email = emailInput.value.trim();
                var password = passwordInput.value;

                if (!email || !password || !birthdateInput.value) {
                    showError('Fill in your email, a password and your date of birth.');
                    return;
                }
                if (password.length < 8) {
                    showError('Passwords need to be at least 8 characters.');
                    return;
                }
                if (password !== repeatInput.value) {
                    showError('Those passwords do not match.');
                    return;
                }
                if (!isOldEnough(birthdateInput.value)) {
                    showError('You need to be at least 13 to use Friends with Habits.');
                    return;
                }
                if (!agreeInput.checked) {
                    showError('Please accept the Terms of Service and Privacy Policy.');
                    return;
                }

                submitBtn.disabled = true;
                submitBtn.textContent = 'Creating account…';

                fetch(API_BASE + '/users-service/users', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'x-brand-variation': 'habits' },
                    body: JSON.stringify({
                        email: email,
                        password: password,
                        settingsBirthdate: birthdateInput.value,
                        hasAgreedToTerms: true,
                        settingsEmailMarketing: !!marketingInput.checked,
                        website: honeypotInput.value,
                        userAcquisition: storedAttribution(),
                    }),
                }).then(function (res) {
                    return res.json().then(function (body) { return { res: res, body: body }; })
                        .catch(function () { return { res: res, body: {} }; });
                }).then(function (out) {
                    if (!out.res.ok) {
                        showError((out.body && out.body.message) || 'We could not create that account. Try again.');
                        return;
                    }
                    // The conversion the Search campaign optimises toward. Mark
                    // it as a key event in GA4 admin and import it into Ads, or
                    // the campaign has nothing to bid on.
                    track('sign_up', { method: 'habits_web' });
                    form.hidden = true;
                    doneBox.hidden = false;
                    doneBox.scrollIntoView({ block: 'center' });
                }).catch(function () {
                    showError('Network error. Try again in a moment.');
                }).then(function () {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Create account';
                });
            });

            document.getElementById('store-cta-done').addEventListener('click', function () {
                track('store_click', { link_url: STORE_URL, location: 'register_success' });
            });
        })();
    </script>
</body>
</html>
