<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="canonical" href="{{canonicalUrl}}">
    <meta name="description" content="{{description}}">
    <meta name="robots" content="noindex">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;800&display=swap">
    <link rel="icon" type="image/x-icon" href="/assets/images/favicon-habits.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-habits-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-habits-16x16.png">
    <style>
        :root {
            --habits-navy: #102a43;
            --habits-coral: #ff6b35;
            --habits-coral-dark: #e0521e;
            --habits-cream: #fff8f3;
            --habits-text: #243b53;
            --habits-text-muted: #627d98;
            --habits-border: #d9e2ec;
            --habits-error: #c53030;
        }
        *, *::before, *::after { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            font-family: 'Lexend', -apple-system, BlinkMacSystemFont, sans-serif;
            font-size: 16px;
            line-height: 1.6;
            color: var(--habits-text);
            background: var(--habits-cream);
            min-height: 100vh;
        }
        a { color: var(--habits-coral-dark); }
        header.site-header {
            padding: 1.25rem 0;
            border-bottom: 1px solid var(--habits-border);
            background: #fff;
        }
        .container {
            max-width: 480px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }
        header.site-header .container {
            display: flex;
            align-items: center;
            gap: 0.625rem;
        }
        header.site-header .brand-mark {
            width: 2rem;
            height: 2rem;
            display: block;
        }
        header.site-header .brand {
            font-weight: 800;
            font-size: 1.125rem;
            color: var(--habits-navy);
            letter-spacing: -0.01em;
        }
        main.wrap {
            padding: 3.5rem 0 3rem;
        }
        h1 {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--habits-navy);
            margin: 0 0 0.5rem;
            letter-spacing: -0.02em;
            text-align: center;
        }
        p.lede {
            color: var(--habits-text-muted);
            margin: 0 0 1.75rem;
            text-align: center;
        }
        form.login-form {
            background: #fff;
            border: 1px solid var(--habits-border);
            border-radius: 0.75rem;
            padding: 1.5rem;
            box-shadow: 0 1px 2px rgba(16, 42, 67, 0.04);
        }
        label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            margin: 0 0 0.375rem;
            color: var(--habits-navy);
        }
        input[type="tel"], input[type="text"] {
            width: 100%;
            padding: 0.75rem 0.875rem;
            border: 1px solid var(--habits-border);
            border-radius: 0.5rem;
            font-size: 1rem;
            font-family: inherit;
            margin-bottom: 1rem;
            background: #fff;
        }
        input[type="tel"]:focus, input[type="text"]:focus {
            outline: 2px solid var(--habits-coral);
            outline-offset: 1px;
        }
        .cta {
            display: inline-block;
            width: 100%;
            padding: 0.875rem 1.75rem;
            background: var(--habits-coral);
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
            border-radius: 999px;
            border: 0;
            cursor: pointer;
            transition: background 0.15s ease;
            text-decoration: none;
            text-align: center;
        }
        .cta:hover { background: var(--habits-coral-dark); }
        .cta:disabled { background: var(--habits-text-muted); cursor: not-allowed; }
        .link-btn {
            display: block;
            width: 100%;
            margin-top: 0.75rem;
            padding: 0.5rem;
            background: none;
            border: 0;
            font-family: inherit;
            font-size: 0.875rem;
            color: var(--habits-text-muted);
            text-decoration: underline;
            cursor: pointer;
        }
        .link-btn:disabled { cursor: not-allowed; opacity: 0.6; }
        .alert {
            padding: 0.75rem 0.875rem;
            border-radius: 0.5rem;
            margin: 0 0 1rem;
            font-size: 0.9375rem;
            border: 1px solid;
        }
        .alert--error { background: #fff5f5; color: var(--habits-error); border-color: #fed7d7; }
        .alert--success { background: #f0fff4; color: #2f855a; border-color: #c6f6d5; }
        .helper {
            text-align: center;
            margin-top: 1rem;
            font-size: 0.875rem;
            color: var(--habits-text-muted);
        }
        .field-hint {
            margin: -0.5rem 0 1rem;
            font-size: 0.8125rem;
            color: var(--habits-text-muted);
        }
        footer.site-footer {
            padding: 2rem 0 3rem;
            border-top: 1px solid var(--habits-border);
            background: #fff;
            text-align: center;
            color: var(--habits-text-muted);
            font-size: 0.875rem;
        }
        footer.site-footer .footer-links {
            margin-bottom: 0.75rem;
        }
        footer.site-footer .footer-links a {
            margin: 0 0.5rem;
            color: var(--habits-text-muted);
        }
        footer.site-footer .footer-family {
            margin-top: 0.5rem;
        }
        [hidden] { display: none !important; }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="container">
            <img class="brand-mark" src="/assets/images/habits-logo.svg" width="32" height="32" alt="" aria-hidden="true">
            <span class="brand">Friends with Habits</span>
        </div>
    </header>

    <main class="wrap">
        <div class="container">
            <h1>Verify your phone</h1>
            <p class="lede" id="page-lede">We&rsquo;ll text you a code to confirm this number belongs to you.</p>

            <!-- Signed out. Verification is per-account, so there is nothing to do without a session. -->
            <div id="signed-out" hidden>
                <form class="login-form" novalidate onsubmit="return false;">
                    <div class="alert alert--error">Sign in first so we know which account to verify.</div>
                    <a class="cta" id="signin-link" href="/login">Sign in</a>
                </form>
            </div>

            <!-- Step 1: number entry -->
            <form class="login-form" id="phone-form" novalidate hidden>
                <div class="alert alert--error" id="phone-error" hidden></div>

                <label for="phone">Mobile phone</label>
                <input id="phone" type="tel" name="phone" autocomplete="tel" inputmode="tel"
                    placeholder="+1 317 555 1234" required>
                <div class="field-hint">Include your country code, e.g. +1 for the US.</div>

                <button class="cta" type="submit" id="phone-submit">Send code</button>
            </form>

            <!-- Step 2: code entry -->
            <form class="login-form" id="code-form" novalidate hidden>
                <div class="alert alert--error" id="code-error" hidden></div>

                <label for="code">Verification code</label>
                <input id="code" type="text" name="code" autocomplete="one-time-code" inputmode="numeric" required>

                <button class="cta" type="submit" id="code-submit">Verify</button>
                <button class="link-btn" type="button" id="resend-btn">Send a new code</button>
            </form>

            <!-- Done -->
            <div id="done" hidden>
                <form class="login-form" novalidate onsubmit="return false;">
                    <div class="alert alert--success">Your phone number is verified.</div>
                    <a class="cta" href="/">Done</a>
                    <div class="helper">You can head back to the app — the change takes effect on your next launch.</div>
                </form>
            </div>
        </div>
    </main>

    {{> habitsFooter}}

    <script>
        (function () {
            var API_BASE = {{{apiBaseJson}}};

            var signedOut = document.getElementById('signed-out');
            var signinLink = document.getElementById('signin-link');
            var phoneForm = document.getElementById('phone-form');
            var codeForm = document.getElementById('code-form');
            var doneBox = document.getElementById('done');
            var lede = document.getElementById('page-lede');
            var phoneInput = document.getElementById('phone');
            var codeInput = document.getElementById('code');
            var phoneSubmit = document.getElementById('phone-submit');
            var codeSubmit = document.getElementById('code-submit');
            var resendBtn = document.getElementById('resend-btn');
            var phoneError = document.getElementById('phone-error');
            var codeError = document.getElementById('code-error');

            // Session layout matches habits/login.hbs and the React store: `therrUser` is
            // stored FLAT (id / idToken at the top level), and store.tsx is what wraps it in
            // `details` when the React app boots. Reading it flat here keeps a session minted
            // by either surface usable by the other.
            function readStoredUser() {
                try {
                    var raw = sessionStorage.getItem('therrUser') || localStorage.getItem('therrUser');
                    return raw ? JSON.parse(raw) : null;
                } catch (e) {
                    return null;
                }
            }

            function writeStoredUser(user) {
                try {
                    var raw = JSON.stringify(user);
                    if (sessionStorage.getItem('therrUser')) { sessionStorage.setItem('therrUser', raw); }
                    if (localStorage.getItem('therrUser')) { localStorage.setItem('therrUser', raw); }
                } catch (e) { /* storage disabled — the server already has the change */ }
            }

            var storedUser = readStoredUser();

            if (!storedUser || !storedUser.idToken || !storedUser.id) {
                // Come back here after signing in rather than dropping the user on their
                // profile with no hint that they were mid-verification.
                signinLink.setAttribute('href', '/login?returnTo=' + encodeURIComponent('/verify-phone'));
                signedOut.hidden = false;
                lede.textContent = 'Verification is tied to your account.';
                return;
            }

            function authHeaders() {
                return {
                    'Content-Type': 'application/json',
                    'authorization': 'Bearer ' + storedUser.idToken,
                    'x-userid': storedUser.id,
                    'x-brand-variation': 'habits',
                    'x-localecode': 'en-us',
                };
            }

            function showError(box, msg) {
                box.textContent = msg;
                box.hidden = false;
            }

            function clearError(box) {
                box.hidden = true;
                box.textContent = '';
            }

            function postJson(path, body) {
                return fetch(API_BASE + path, {
                    method: 'POST',
                    headers: authHeaders(),
                    body: JSON.stringify(body),
                }).then(function (res) {
                    return res.json()
                        .then(function (data) { return { res: res, body: data }; })
                        .catch(function () { return { res: res, body: {} }; });
                });
            }

            // The gateway normalizes the number itself, so this only needs to catch obvious
            // typos before spending an SMS on them.
            function isPlausiblePhone(value) {
                var digits = value.replace(/[^0-9]/g, '');
                return digits.length >= 7 && digits.length <= 15;
            }

            var pendingPhoneNumber = '';

            function sendCode(phoneNumber, errorBox, button, busyLabel, idleLabel) {
                button.disabled = true;
                button.textContent = busyLabel;

                return postJson('/phone/verify', { phoneNumber: phoneNumber }).then(function (out) {
                    if (!out.res.ok) {
                        if (out.res.status === 401 || out.res.status === 403) {
                            showError(errorBox, 'Your session expired. Sign in again to continue.');
                            return false;
                        }
                        var code = out.body && out.body.errorCode;
                        // Values mirror therr-js-utilities ErrorCodes (USER_EXISTS,
                        // TOO_MANY_ACCOUNTS, INVALID_REGION). Inlined because this template
                        // ships no bundle — keep them in sync if that enum changes.
                        if (code === 'UserAlreadyExists' || code === 'OnlyThreeAccountsPerPhoneNumber') {
                            showError(errorBox, 'That phone number is already in use for this account type.');
                        } else if (code === 'InvalidRegion') {
                            showError(errorBox, 'SMS verification is not available for your region. Try a different number.');
                        } else {
                            showError(errorBox, (out.body && out.body.message) || 'Could not send the code. Try again in a moment.');
                        }
                        return false;
                    }
                    pendingPhoneNumber = phoneNumber;
                    return true;
                }).catch(function () {
                    showError(errorBox, 'Network error. Try again in a moment.');
                    return false;
                }).then(function (ok) {
                    button.disabled = false;
                    button.textContent = idleLabel;
                    return ok;
                });
            }

            phoneForm.hidden = false;
            phoneInput.focus();

            phoneForm.addEventListener('submit', function (e) {
                e.preventDefault();
                clearError(phoneError);

                var phoneNumber = phoneInput.value.trim();
                if (!isPlausiblePhone(phoneNumber)) {
                    showError(phoneError, 'Enter a valid phone number, including the country code.');
                    return;
                }

                sendCode(phoneNumber, phoneError, phoneSubmit, 'Sending…', 'Send code').then(function (ok) {
                    if (!ok) { return; }
                    phoneForm.hidden = true;
                    codeForm.hidden = false;
                    lede.textContent = 'Enter the code we texted to ' + phoneNumber + '.';
                    codeInput.focus();
                });
            });

            resendBtn.addEventListener('click', function () {
                clearError(codeError);
                sendCode(pendingPhoneNumber, codeError, resendBtn, 'Sending…', 'Send a new code');
            });

            codeForm.addEventListener('submit', function (e) {
                e.preventDefault();
                clearError(codeError);

                var verificationCode = codeInput.value.trim();
                if (!verificationCode) {
                    showError(codeError, 'Enter the code we texted you.');
                    return;
                }

                codeSubmit.disabled = true;
                codeSubmit.textContent = 'Verifying…';

                postJson('/phone/validate-code', { verificationCode: verificationCode }).then(function (out) {
                    if (!out.res.ok) {
                        if (out.res.status === 401 || out.res.status === 403) {
                            showError(codeError, 'Your session expired. Sign in again to continue.');
                        } else {
                            showError(codeError, 'That code is invalid or expired. Try again, or send a new one.');
                        }
                        return;
                    }

                    // /phone/validate-code persists the number AND grants MOBILE_VERIFIED
                    // server-side (via PUT /users/:id/verify-phone), so there is no follow-up
                    // write to make — only the local copy of the session to refresh, so the
                    // React surface does not read a stale accessLevels array.
                    //
                    // The gateway answers 201 with an EMPTY body, so there is no user object
                    // to copy from the response. Apply the same two changes the server just
                    // made to the stored session directly. The access level string mirrors
                    // AccessLevels.MOBILE_VERIFIED in therr-js-utilities — inlined for the
                    // same reason the ErrorCodes above are: this template ships no bundle.
                    var levels = Array.isArray(storedUser.accessLevels) ? storedUser.accessLevels.slice() : [];
                    if (levels.indexOf('user.verified.mobile') === -1) {
                        levels.push('user.verified.mobile');
                    }
                    writeStoredUser(Object.assign({}, storedUser, {
                        accessLevels: levels,
                        phoneNumber: pendingPhoneNumber,
                    }));

                    codeForm.hidden = true;
                    doneBox.hidden = false;
                    lede.textContent = '';
                }).catch(function () {
                    showError(codeError, 'Network error. Try again in a moment.');
                }).then(function () {
                    codeSubmit.disabled = false;
                    codeSubmit.textContent = 'Verify';
                });
            });
        })();
    </script>
</body>
</html>
